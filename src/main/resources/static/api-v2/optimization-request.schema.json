{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptimizationRequest (v2 / nesting-v1 or slitting-v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "problemType": {
      "type": "string",
      "enum": [
        "NESTING_2D",
        "SLITTING_1D"
      ]
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "problem": {
      "oneOf": [
        {
          "$ref": "#/$defs/NestingProblem"
        },
        {
          "$ref": "#/$defs/SlittingProblem"
        }
      ]
    },
    "allowFallback": {
      "type": "boolean"
    },
    "requireComplete": {
      "type": "boolean"
    },
    "strategy": {
      "$ref": "#/$defs/Strategy"
    }
  },
  "required": [
    "schemaVersion",
    "problemType",
    "clientRequestId",
    "problem",
    "allowFallback",
    "requireComplete"
  ],
  "$defs": {
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RECTANGLE",
            "POLYGON"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        }
      },
      "required": [
        "type",
        "width",
        "height"
      ]
    },
    "Exclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "clearance": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "shape"
      ]
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exclusion"
          }
        },
        "continuesAfterRegion": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "shape"
      ]
    },
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "allowRotation": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "shape",
        "quantity"
      ]
    },
    "Process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "CROSSCUT",
            "GUILLOTINE",
            "CONTOUR"
          ]
        },
        "feedMode": {
          "type": "string",
          "enum": [
            "SHEET",
            "CONTINUOUS"
          ]
        },
        "startCorner": {
          "type": "string",
          "enum": [
            "left-top",
            "right-top",
            "left-bottom",
            "right-bottom"
          ]
        },
        "firstStageOrientation": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical",
            "none"
          ]
        },
        "trimStart": {
          "type": "number",
          "minimum": 0
        },
        "minReusableWidth": {
          "type": "number",
          "minimum": 0
        },
        "minReusableHeight": {
          "type": "number",
          "minimum": 0
        },
        "kerf": {
          "type": "number",
          "const": 0
        },
        "objective": {
          "type": "string"
        },
        "pieceGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        }
      },
      "required": [
        "mode",
        "feedMode",
        "startCorner",
        "firstStageOrientation",
        "objective"
      ]
    },
    "NestingProblem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "unit": {
          "type": "string",
          "const": "mm"
        },
        "material": {
          "$ref": "#/$defs/Material"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "process": {
          "$ref": "#/$defs/Process"
        },
        "engine": {
          "type": [
            "string",
            "null"
          ],
          "default": "auto"
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "schemaVersion",
        "unit",
        "material",
        "parts",
        "process",
        "timeLimitSeconds"
      ]
    },
    "Strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "const": "marker-shortening"
        },
        "version": {
          "type": "string",
          "const": "1"
        },
        "maxTrials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "id",
        "version",
        "maxTrials"
      ]
    },
    "SlittingProblem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "unit": {
          "type": "string",
          "const": "mm"
        },
        "motherWidthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "leftTrimMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "rightTrimMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "minWidthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxWidthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "widthStepMm": {
          "type": "integer",
          "minimum": 1
        },
        "totalOverCap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "profile": {
          "type": "string",
          "enum": [
            "FAST",
            "QUALITY"
          ]
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "widthMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "lengthMm": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1000000000,
                "multipleOf": 1000
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "surfaceTreatment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "widthMm",
              "lengthMm",
              "quantity",
              "surfaceTreatment"
            ]
          },
          "minItems": 1,
          "maxItems": 500
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "schemaVersion",
        "unit",
        "motherWidthMm",
        "leftTrimMm",
        "rightTrimMm",
        "minWidthMm",
        "maxWidthMm",
        "widthStepMm",
        "totalOverCap",
        "profile",
        "orders",
        "timeLimitSeconds"
      ],
      "description": "整数 mm；当前内核卷长必须整除1000。ID唯一，候选宽度不超过扣边可用幅宽；需求总卷数+超产上限<=100000。跨字段约束由服务验证。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "problemType": {
            "const": "SLITTING_1D"
          }
        }
      },
      "then": {
        "properties": {
          "problem": {
            "$ref": "#/$defs/SlittingProblem"
          }
        },
        "not": {
          "required": [
            "strategy"
          ]
        }
      },
      "else": {
        "properties": {
          "problem": {
            "$ref": "#/$defs/NestingProblem"
          }
        }
      }
    }
  ]
}
