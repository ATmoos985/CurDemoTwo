{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptimizationRequest (v2 / nesting-v1 or slitting-v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "problemType": {
      "type": "string",
      "enum": [
        "NESTING_2D",
        "SLITTING_1D"
      ]
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "problem": {
      "oneOf": [
        {
          "$ref": "#/$defs/NestingProblem"
        },
        {
          "$ref": "#/$defs/SlittingProblem"
        }
      ]
    },
    "allowFallback": {
      "type": "boolean"
    },
    "requireComplete": {
      "type": "boolean"
    },
    "strategy": {
      "$ref": "#/$defs/Strategy"
    }
  },
  "required": [
    "schemaVersion",
    "problemType",
    "clientRequestId",
    "problem",
    "allowFallback",
    "requireComplete"
  ],
  "$defs": {
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RECTANGLE",
            "POLYGON"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "holes": {
          "type": [
            "array",
            "null"
          ],
          "description": "CONTOUR only. Optional interior hole rings (each ring >= 3 vertices, strictly inside outer contour).",
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/Point"
            }
          }
        }
      },
      "required": [
        "type",
        "width",
        "height"
      ]
    },
    "FabricRule": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional fabric-level rule for curtain selvedge exclusion and bi-axial pattern repeat.",
      "properties": {
        "leftSelvedgeMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rightSelvedgeMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "allowAuxiliaryInSelvedge": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "repeatYMm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "phaseYMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "repeatXMm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "phaseXMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "PartRule": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional per-part rule for MAIN/AUXILIARY role, bi-axial pattern matching, discrete allowed angles, and consistent grain group.",
      "properties": {
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "MAIN",
            "AUXILIARY",
            null
          ]
        },
        "patternMatch": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "patternAnchorYMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "patternToleranceMm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "allowedAnglesDeg": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 72,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "description": "CONTOUR only. Discrete allowed rotation angles in integer degrees [0, 359]."
        },
        "patternAnchorXMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "grainGroupId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "description": "Optional consistent nap/grain group identifier; all parts sharing a grainGroupId use the same warp orientation (0 or 180 deg)."
        }
      }
    },
    "Exclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "clearance": {
          "type": "number",
          "minimum": 0
        },
        "severity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4,
          "description": "Optional defect severity level: 1=minor, 2=moderate, 3=severe, 4=fatal."
        },
        "avoidancePolicy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "HARD_FORBID",
            "MUST_AVOID",
            "ALLOW_AUXILIARY",
            "ALLOW_REMNANT",
            "PENETRABLE",
            null
          ],
          "description": "Optional defect avoidance policy overriding default severity rules."
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "shape"
      ]
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exclusion"
          }
        },
        "continuesAfterRegion": {
          "type": "boolean"
        },
        "fabricRule": {
          "oneOf": [
            {
              "$ref": "#/$defs/FabricRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "shape"
      ]
    },
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "allowRotation": {
          "type": "boolean"
        },
        "allowHalfTurn": {
          "type": "boolean",
          "description": "CONTOUR only. With allowRotation false, true permits 0 and 180 degrees. Full rotation permission still permits all four quarter turns."
        },
        "rule": {
          "oneOf": [
            {
              "$ref": "#/$defs/PartRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "shape",
        "quantity"
      ]
    },
    "Process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "CROSSCUT",
            "GUILLOTINE",
            "CONTOUR"
          ]
        },
        "feedMode": {
          "type": "string",
          "enum": [
            "SHEET",
            "CONTINUOUS"
          ]
        },
        "startCorner": {
          "type": "string",
          "enum": [
            "left-top",
            "right-top",
            "left-bottom",
            "right-bottom"
          ]
        },
        "firstStageOrientation": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical",
            "none"
          ]
        },
        "trimStart": {
          "type": "number",
          "minimum": 0
        },
        "minReusableWidth": {
          "type": "number",
          "minimum": 0
        },
        "minReusableHeight": {
          "type": "number",
          "minimum": 0
        },
        "kerf": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "multipleOf": 0.1
        },
        "objective": {
          "type": "string"
        },
        "pieceGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        },
        "maxStages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16,
          "description": "GUILLOTINE only. Optional maximum guillotine cutting stages (1-16)."
        }
      },
      "required": [
        "mode",
        "feedMode",
        "startCorner",
        "firstStageOrientation",
        "objective"
      ]
    },
    "NestingProblem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "unit": {
          "type": "string",
          "const": "mm"
        },
        "material": {
          "$ref": "#/$defs/Material"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "process": {
          "$ref": "#/$defs/Process"
        },
        "engine": {
          "type": [
            "string",
            "null"
          ],
          "default": "auto"
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "schemaVersion",
        "unit",
        "material",
        "parts",
        "process",
        "timeLimitSeconds"
      ]
    },
    "Strategy": {
      "type": "object",
      "additionalProperties": false,
      "if": {"anyOf": [{"required": ["gapFillLimits"]}, {"required": ["initialPlacements"]}]},
      "then": {"properties": {"version": {"const": "2"}}},
      "properties": {
        "id": {
          "type": "string",
          "const": "marker-shortening"
        },
        "version": {
          "type": "string",
          "enum": ["1", "2"]
        },
        "initialPlacements": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "description": "Optional complete starting layout. The server rebuilds the outlines from the order and validates the geometry before using it.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["demandId", "x", "y", "rotationDegrees"],
            "properties": {
              "demandId": {"type": "integer"},
              "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
              "rotationDegrees": {"type": "integer", "enum": [0, 90, 180, 270]}
            }
          }
        },
        "gapFillLimits": {
          "type": "object",
          "description": "Marker v2 only. Maximum extra pieces for each existing part ID within the complete marker. Job fulfillment excludes these spare pieces.",
          "minProperties": 1,
          "maxProperties": 80,
          "propertyNames": {"pattern": "^-?(0|[1-9][0-9]*)$"},
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 80}
        },
        "maxTrials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "id",
        "version",
        "maxTrials"
      ]
    },
    "SlittingProblem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "unit": {
          "type": "string",
          "const": "mm"
        },
        "motherWidthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "leftTrimMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "rightTrimMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "minWidthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxWidthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "widthStepMm": {
          "type": "integer",
          "minimum": 1
        },
        "totalOverCap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "profile": {
          "type": "string",
          "enum": [
            "FAST",
            "QUALITY"
          ]
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "widthMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "lengthMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "surfaceTreatment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "widthMm",
              "lengthMm",
              "quantity",
              "surfaceTreatment"
            ]
          },
          "minItems": 1,
          "maxItems": 500
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "topK": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maxPatterns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxDistinctWidths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "stageTimeLimitMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "useOptimizedAssignment": {
          "type": "boolean"
        },
        "underPenalty": {
          "type": "number",
          "minimum": 0
        },
        "seqGroupAlpha": {
          "type": "number",
          "minimum": 0
        },
        "seqGroupBeta": {
          "type": "number",
          "minimum": 0
        },
        "lnsEnabled": {
          "type": "boolean"
        },
        "maxKnives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100,
          "description": "Optional maximum simultaneous strips/knives per slitting car (1-100)."
        },
        "minBladeSpacingMm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000,
          "description": "Optional minimum physical blade spacing in mm (1-100000)."
        },
        "forbiddenNarrowEdgeMinMm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000,
          "description": "Optional forbidden narrow tail edge lower bound in mm (paired with forbiddenNarrowEdgeMaxMm)."
        },
        "forbiddenNarrowEdgeMaxMm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000,
          "description": "Optional forbidden narrow tail edge upper bound in mm (paired with forbiddenNarrowEdgeMinMm)."
        },
        "kerfMm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 500,
          "description": "Optional kerf loss per cut between adjacent strips in mm (0-500)."
        },
        "candidateRollWidths": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 50,
          "description": "Optional multi-width mother roll pool for joint width selection.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "widthMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "availableRolls": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "widthMm"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "unit",
        "motherWidthMm",
        "leftTrimMm",
        "rightTrimMm",
        "minWidthMm",
        "maxWidthMm",
        "widthStepMm",
        "totalOverCap",
        "profile",
        "orders",
        "timeLimitSeconds"
      ],
      "description": "宽度与卷长为整数 mm，非整米卷长保持精确值。ID唯一，候选宽度不超过扣边可用幅宽；需求总卷数+超产上限<=100000。跨字段约束由服务验证。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "problemType": {
            "const": "SLITTING_1D"
          }
        }
      },
      "then": {
        "properties": {
          "problem": {
            "$ref": "#/$defs/SlittingProblem"
          }
        },
        "not": {
          "required": [
            "strategy"
          ]
        }
      },
      "else": {
        "properties": {
          "problem": {
            "$ref": "#/$defs/NestingProblem"
          }
        }
      }
    }
  ]
}
