  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "Shape": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "RECTANGLE",
              "POLYGON"
            ]
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000000
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000000
          },
          "vertices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          }
        },
        "required": [
          "type",
          "width",
          "height"
        ]
      },
      "Exclusion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "clearance": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "shape"
        ]
      },
      "Material": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "exclusions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Exclusion"
            }
          },
          "continuesAfterRegion": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "shape"
        ]
      },
      "Part": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "allowRotation": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "shape",
          "quantity"
        ]
      },
      "Process": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "CROSSCUT",
              "GUILLOTINE",
              "CONTOUR"
            ]
          },
          "feedMode": {
            "type": "string",
            "enum": [
              "SHEET",
              "CONTINUOUS"
            ]
          },
          "startCorner": {
            "type": "string",
            "enum": [
              "left-top",
              "right-top",
              "left-bottom",
              "right-bottom"
            ]
          },
          "firstStageOrientation": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical",
              "none"
            ]
          },
          "trimStart": {
            "type": "number",
            "minimum": 0
          },
          "minReusableWidth": {
            "type": "number",
            "minimum": 0
          },
          "minReusableHeight": {
            "type": "number",
            "minimum": 0
          },
          "kerf": {
            "type": "number",
            "const": 0
          },
          "objective": {
            "type": "string"
          },
          "pieceGap": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 0.1
          }
        },
        "required": [
          "mode",
          "feedMode",
          "startCorner",
          "firstStageOrientation",
          "objective"
        ]
      },
      "NestingProblem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1"
          },
          "unit": {
            "type": "string",
            "const": "mm"
          },
          "material": {
            "$ref": "#/components/schemas/Material"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          },
          "process": {
            "$ref": "#/components/schemas/Process"
          },
          "engine": {
            "type": [
              "string",
              "null"
            ],
            "default": "auto"
          },
          "timeLimitSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "required": [
          "schemaVersion",
          "unit",
          "material",
          "parts",
          "process",
          "timeLimitSeconds"
        ]
      },
      "OptimizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "2.0"
          },
          "problemType": {
            "type": "string",
            "const": "NESTING_2D"
          },
          "clientRequestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "problem": {
            "$ref": "#/components/schemas/NestingProblem"
          },
          "allowFallback": {
            "type": "boolean"
          },
          "requireComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "schemaVersion",
          "problemType",
          "clientRequestId",
          "problem",
          "allowFallback",
