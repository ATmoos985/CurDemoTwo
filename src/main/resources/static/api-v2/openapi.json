{
  "openapi": "3.1.0",
  "info": {
    "title": "CurDemoTwo Optimization Jobs",
    "version": "2.0.0",
    "description": "Single-dispatcher local job archive, nesting-v1 geometry profile. No inventory writes. v1 endpoints remain compatible. No distributed leases, SSE, authentication or multi-material support in this stage. Schema validation is followed by engine and geometry checks. timeLimitSeconds requests cooperative interruption, not guaranteed hard preemption."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v2/capabilities": {
      "get": {
        "summary": "Query real engine availability and implemented job features",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or no result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
